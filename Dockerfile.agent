# CPU linux/amd64 Pi image. Default: one native submit call per case (booklets on 70B, references on 8B), paragraph context ranked by translated-claim BM25 and a local static embedding, escalation to the full vote pages when unsupported. No runtime downloads.
FROM node:26.10.0-bookworm-slim AS pi
WORKDIR /build
COPY track_2a/dev/format/package.json track_2a/dev/format/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM python:3.11-slim-bookworm AS embed
# Static multilingual embedding for paragraph retrieval (numpy only at runtime).
# Weights are fetched at build time and quantized to int8; nothing is downloaded at runtime.
RUN pip install --no-cache-dir model2vec==0.10.0
RUN python -c "from model2vec import StaticModel; StaticModel.from_pretrained('minishlab/potion-multilingual-128M', quantize_to='int8').save_pretrained('/models/potion-multilingual-128M-int8')"

FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libatomic1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir model2vec==0.10.0
COPY --from=embed /models /app/models
COPY --from=pi /usr/local/bin/node /usr/local/bin/node
COPY --from=pi /usr/local/LICENSE /usr/share/doc/node/LICENSE
WORKDIR /app
COPY --from=pi /build/node_modules /app/track_2a/dev/format/node_modules
COPY track_2a/src /app/track_2a/src
COPY track_2a/dev/format/*.py track_2a/dev/format/*.ts track_2a/dev/format/*.mjs track_2a/dev/format/package.json track_2a/dev/format/package-lock.json /app/track_2a/dev/format/
COPY track_2a/dev/cscs/cscs_check.py track_2a/dev/cscs/cscs_dev54.py /app/track_2a/dev/cscs/
COPY track_2a/dev/cscs/vendor /app/track_2a/dev/cscs/vendor
ENV PYTHONDONTWRITEBYTECODE=1 PI_OFFLINE=1 PIPELINE=R CONTEXT_SELECTION=claim_paragraphs CLAIM_SPANS=8 TOOL_STEP=baseline
ENTRYPOINT ["python", "/app/track_2a/dev/format/runtime.py"]
CMD ["--input", "/data/cases.jsonl", "--output", "/output/predictions.jsonl"]
